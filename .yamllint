---
extends: default

rules:
  # GitHub workflow / settings files don't use an explicit document start.
  document-start: disable
  # `on:` and similar keys are intentional, not booleans.
  truthy:
    check-keys: false
  line-length:
    max: 120
    level: error
  # Keep the genuinely useful structural checks strict.
  key-duplicates: enable
