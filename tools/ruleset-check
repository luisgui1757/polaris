#!/usr/bin/env bash
# Semantic verifier for Sentinel's required main-branch GitHub rulesets.
#
# Defaults to checking the checked-in .github/rulesets/*.json files. With
# --repo owner/name it fetches the live GitHub rulesets read-only via gh first,
# then applies the same semantic checks.
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

RULESET_DIR="$REPO_ROOT/.github/rulesets"
OWNER_ID=""
LIVE_REPO=""

usage() {
  cat <<'EOF'
ruleset-check [--ruleset-dir DIR] [--owner-id ID]
ruleset-check --repo owner/repo [--owner-id ID]

Verifies the semantic contract for Sentinel's main-branch rulesets:
  - three active branch rulesets targeting refs/heads/main
  - owner User bypass in always mode
  - integrity ruleset: PR required, squash-only, strict required ci from the
    GitHub Actions app, linear history, deletion protection, non-fast-forward
    protection
  - review ruleset: code-owner review, last-push approval, thread resolution
  - owner-updates ruleset: only bypass actors can update main

--ruleset-dir checks local/exported JSON files.
--repo fetches live GitHub rulesets read-only with gh and checks those.
--owner-id also verifies the exact bypass actor id.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ruleset-dir)
      shift
      RULESET_DIR=${1:?--ruleset-dir needs a directory}
      ;;
    --ruleset-dir=*)
      RULESET_DIR=${1#--ruleset-dir=}
      ;;
    --owner-id)
      shift
      OWNER_ID=${1:?--owner-id needs an id}
      ;;
    --owner-id=*)
      OWNER_ID=${1#--owner-id=}
      ;;
    --repo)
      shift
      LIVE_REPO=${1:?--repo needs owner/repo}
      ;;
    --repo=*)
      LIVE_REPO=${1#--repo=}
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ruleset-check: unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v jq >/dev/null 2>&1; then
  echo "ruleset-check: FAIL: jq is required for semantic ruleset checks." >&2
  exit 1
fi

if [[ -n "$LIVE_REPO" ]]; then
  if [[ "$LIVE_REPO" != */* ]]; then
    echo "ruleset-check: FAIL: --repo must be owner/repo, got: $LIVE_REPO" >&2
    exit 2
  fi
  if ! command -v gh >/dev/null 2>&1; then
    echo "ruleset-check: FAIL: gh is required for --repo live checks." >&2
    exit 1
  fi
fi

tmp_dir=""
trap '[[ -n "$tmp_dir" ]] && rm -rf "$tmp_dir"' EXIT

failures=0
fail() {
  echo "ruleset-check: FAIL: $*" >&2
  failures=1
}

fetch_live_rulesets() {
  local repo=$1 name file id list_json

  tmp_dir=$(mktemp -d)
  RULESET_DIR="$tmp_dir"

  if [[ -z "$OWNER_ID" ]]; then
    OWNER_ID=$(gh api "repos/$repo" --jq '.owner.id' 2>/dev/null || true)
    if [[ -z "$OWNER_ID" ]]; then
      fail "could not resolve live repository owner id for $repo"
    fi
  fi

  if ! list_json=$(gh api "repos/$repo/rulesets?includes_parents=false"); then
    fail "could not list live rulesets for $repo"
    return
  fi

  while IFS='|' read -r name file; do
    id=$(printf '%s\n' "$list_json" \
      | jq -r --arg name "$name" '[.[] | select(.name == $name) | .id] | first // empty')
    if [[ -z "$id" ]]; then
      fail "live ruleset missing: $name"
      continue
    fi
    if ! gh api "repos/$repo/rulesets/$id" > "$RULESET_DIR/$file"; then
      fail "could not fetch live ruleset: $name"
    fi
  done <<'EOF'
Protect main: integrity|main-integrity.json
Protect main: review|main-review.json
Protect main: owner updates|main-owner-updates.json
EOF
}

jq_check() {
  local file=$1 desc=$2
  shift 2
  if ! jq -e "$@" "$file" >/dev/null; then
    fail "$(basename "$file"): $desc"
  fi
}

require_file() {
  local file=$1
  if [[ ! -f "$file" ]]; then
    fail "missing ruleset file: $file"
    return 1
  fi
  return 0
}

require_common_ruleset() {
  local file=$1 expected_name=$2
  require_file "$file" || return

  jq_check "$file" "name is '$expected_name'" --arg name "$expected_name" ".name == \$name"
  jq_check "$file" "target is branch" '.target == "branch"'
  jq_check "$file" "enforcement is active" '.enforcement == "active"'
  jq_check "$file" "includes only refs/heads/main" '.conditions.ref_name.include == ["refs/heads/main"]'
  jq_check "$file" "has no excluded refs" '.conditions.ref_name.exclude == []'
  jq_check "$file" "has exactly one bypass actor" '(.bypass_actors | length) == 1'
  jq_check "$file" "bypass actor is a User" '.bypass_actors[0].actor_type == "User"'
  jq_check "$file" "bypass mode is always" '.bypass_actors[0].bypass_mode == "always"'
  jq_check "$file" "bypass actor id is numeric" '.bypass_actors[0].actor_id | type == "number"'
  if [[ -n "$OWNER_ID" ]]; then
    jq_check "$file" "bypass actor id matches repository owner" \
      --argjson owner_id "$OWNER_ID" ".bypass_actors[0].actor_id == \$owner_id"
  fi
}

require_rule_types() {
  local file=$1 expected_json=$2
  jq_check "$file" "has exactly the expected rule types" \
    --argjson expected "$expected_json" "([.rules[].type] | sort) == (\$expected | sort)"
}

validate_integrity() {
  local file="$RULESET_DIR/main-integrity.json"
  require_common_ruleset "$file" "Protect main: integrity"
  require_file "$file" || return

  require_rule_types "$file" '[
    "deletion",
    "non_fast_forward",
    "pull_request",
    "required_linear_history",
    "required_status_checks"
  ]'
  jq_check "$file" "pull request rule requires squash-only merges" '
    (.rules[] | select(.type == "pull_request") | .parameters.allowed_merge_methods) == ["squash"]
  '
  jq_check "$file" "pull request rule requires PRs but not approving reviews" '
    (.rules[] | select(.type == "pull_request") | .parameters.required_approving_review_count) == 0
  '
  jq_check "$file" "integrity PR rule does not own review semantics" '
    (.rules[] | select(.type == "pull_request") | .parameters
      | .dismiss_stale_reviews_on_push == false
        and .require_code_owner_review == false
        and .require_last_push_approval == false
        and .required_review_thread_resolution == false)
  '
  jq_check "$file" "required status checks are strict" '
    (.rules[] | select(.type == "required_status_checks") | .parameters.strict_required_status_checks_policy) == true
  '
  jq_check "$file" "required status checks apply on branch creation" '
    (.rules[] | select(.type == "required_status_checks") | .parameters.do_not_enforce_on_create) == false
  '
  jq_check "$file" "required status checks require only GitHub Actions ci" '
    (.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks)
      == [{"context": "ci", "integration_id": 15368}]
  '
}

validate_review() {
  local file="$RULESET_DIR/main-review.json"
  require_common_ruleset "$file" "Protect main: review"
  require_file "$file" || return

  require_rule_types "$file" '["pull_request"]'
  jq_check "$file" "review rule requires one approval" '
    (.rules[] | select(.type == "pull_request") | .parameters.required_approving_review_count) == 1
  '
  jq_check "$file" "review rule requires code-owner review, last-push approval, and thread resolution" '
    (.rules[] | select(.type == "pull_request") | .parameters
      | .dismiss_stale_reviews_on_push == true
        and .require_code_owner_review == true
        and .require_last_push_approval == true
        and .required_review_thread_resolution == true)
  '
  jq_check "$file" "review rule allows only squash merges" '
    (.rules[] | select(.type == "pull_request") | .parameters.allowed_merge_methods) == ["squash"]
  '
}

validate_owner_updates() {
  local file="$RULESET_DIR/main-owner-updates.json"
  require_common_ruleset "$file" "Protect main: owner updates"
  require_file "$file" || return

  require_rule_types "$file" '["update"]'
}

if [[ -n "$LIVE_REPO" ]]; then
  fetch_live_rulesets "$LIVE_REPO"
fi

validate_integrity
validate_review
validate_owner_updates

if [[ "$failures" -ne 0 ]]; then
  exit 1
fi

source_label="$RULESET_DIR"
[[ -n "$LIVE_REPO" ]] && source_label="live $LIVE_REPO"
echo "ruleset-check: ok: $source_label satisfies required main-branch semantics."
exit 0
