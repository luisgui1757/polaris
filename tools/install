#!/usr/bin/env bash
# Sentinel installer.
#
# Renders the Sentinel core into a single inlined "managed block" and writes that
# block into the entrypoint files that AI CLIs auto-load at startup -- so the
# rules are injected with NO tool call and NO slash command. Pointers are not
# used: 4 of the 5 supported tools have no @import syntax, and inlining is the
# only way to get zero visible re-reading everywhere.
#
# Targets (repo-local, default):
#   AGENTS.md                         Codex, opencode, pi, Copilot (VS Code)
#   CLAUDE.md                         Claude Code
#   .github/copilot-instructions.md   GitHub Copilot (broadest surface)
#
# Targets (--global): the same rules, cwd-independent, for every repo:
#   $CODEX_HOME/AGENTS.md             (default ~/.codex/AGENTS.md)        Codex
#   ~/.claude/CLAUDE.md                                                   Claude Code
#   $XDG_CONFIG_HOME/opencode/AGENTS.md (default ~/.config/opencode/...)  opencode
#   $PI_CODING_AGENT_DIR/AGENTS.md    (default ~/.pi/agent/AGENTS.md)     pi
#   Copilot global is NOT file-installable (VS Code profile / github.com
#   personal instructions are UI-only) -- reported as a manual step.
#
# The managed block is delimited by AGENT-RULES:BEGIN / AGENT-RULES:END markers and
# carries the bundle's sha256. Re-running replaces ONLY that block, preserving
# any of your own content above or below it. `--check` re-renders and fails on
# drift (use it in CI / the pre-push hook); `--dry-run` previews.
#
# Usage:
#   tools/install                 write/update THIS repo's entrypoints
#   tools/install --target DIR    write/update ANOTHER repo's entrypoints
#   tools/install --global        write/update global (per-user) entrypoints
#   tools/install --check         verify the blocks are up to date (CI gate)
#   tools/install --remove        remove Sentinel blocks (uninstall; keeps your text)
#   tools/install --dry-run       preview without writing
#   (--target/--global/--check/--remove/--dry-run compose)
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
# shellcheck source=sentinel-lib.sh
source "$SCRIPT_DIR/sentinel-lib.sh"

MANIFEST="$REPO_ROOT/MANIFEST.json"
CORE="$REPO_ROOT/$(sentinel_manifest_core_dir "$MANIFEST")"

SCOPE="repo"
ACTION="write"
TARGET_DIR="$REPO_ROOT"   # which repo gets the repo-local entrypoints
# Refuse more than one action flag rather than silently letting the last one win
# (especially the destructive --remove). install.ps1 does the same, so the CLIs
# behave identically.
set_action() {
  if [[ "$ACTION" != write ]]; then
    echo "install: choose at most one of --check, --remove, --dry-run" >&2; exit 2
  fi
  ACTION=$1
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --global) SCOPE=global ;;
    --check) set_action check ;;
    --dry-run) set_action dry ;;
    --remove|--uninstall) set_action remove ;;
    --target) shift; TARGET_DIR=$(cd "${1:?--target needs a directory}" 2>/dev/null && pwd) || { echo "install: --target directory not found: $1" >&2; exit 2; } ;;
    --target=*) TARGET_DIR=$(cd "${1#--target=}" 2>/dev/null && pwd) || { echo "install: --target directory not found: ${1#--target=}" >&2; exit 2; } ;;
    -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) echo "install: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# Remove the managed block (markers included) from <target> into <out>,
# preserving all surrounding user content. Nonzero on an unterminated block.
remove_block() {
  local target=$1 out=$2
  awk '
    /^<!-- AGENT-RULES:BEGIN/   { skip = 1; next }
    /^<!-- AGENT-RULES:END -->/ { if (skip) { skip = 0; next } }
    skip { next }
    { print }
    END { if (skip) exit 3 }
  ' "$target" > "$out" || return $?
}

targets() {
  if [[ "$SCOPE" == repo ]]; then
    sentinel_repo_adapter_targets "$TARGET_DIR"
  else
    sentinel_global_adapter_targets
  fi
}

blockfile=$(mktemp)
sentinel_render_managed_block "$CORE" "$MANIFEST" "$REPO_ROOT/VERSION" > "$blockfile"
trap 'rm -f "$blockfile"' EXIT

status=0
changed=0
while IFS= read -r t; do
  case "$ACTION" in
    check)
      if [[ -f "$t" ]] && grep -q '^<!-- AGENT-RULES:BEGIN' "$t"; then
        out=$(mktemp)
        if sentinel_compose_adapter "$t" "$blockfile" "$out"; then
          if cmp -s "$t" "$out"; then echo "ok:      $t"; else echo "DRIFT:   $t"; status=1; fi
        else
          echo "MALFORMED: $t (AGENT-RULES:BEGIN without AGENT-RULES:END)"; status=1
        fi
        rm -f "$out"
      else
        if [[ "$SCOPE" == repo ]]; then
          echo "MISSING: $t (no managed block; run tools/install)"; status=1
        else
          echo "absent:  $t (advisory; run tools/install --global)"
        fi
      fi
      ;;
    remove)
      if [[ -f "$t" ]] && grep -q '^<!-- AGENT-RULES:BEGIN' "$t"; then
        out=$(mktemp "$(dirname "$t")/.sentinel.XXXXXX" 2>/dev/null || mktemp)
        if remove_block "$t" "$out"; then
          if grep -q '[^[:space:]]' "$out"; then
            mv "$out" "$t"; echo "removed block: $t (kept surrounding content)"; changed=1
          else
            rm -f "$out" "$t"; echo "removed file:  $t (was Sentinel-only)"; changed=1
          fi
        else
          rm -f "$out"
          echo "install: $t has AGENT-RULES:BEGIN without AGENT-RULES:END; refusing to edit." >&2
          status=1
        fi
      else
        echo "absent:  $t (no managed block to remove)"
      fi
      ;;
    dry)
      out=$(mktemp)
      if sentinel_compose_adapter "$t" "$blockfile" "$out"; then
        if [[ ! -f "$t" ]] || ! cmp -s "$t" "$out"; then echo "would write: $t"; else echo "unchanged:   $t"; fi
      else
        echo "would REFUSE: $t (AGENT-RULES:BEGIN without AGENT-RULES:END -- fix markers)"; status=1
      fi
      rm -f "$out"
      ;;
    write)
      mkdir -p "$(dirname "$t")"
      # Temp in the target's dir so the final mv is atomic (no torn file on crash).
      if ! out=$(mktemp "$(dirname "$t")/.sentinel.XXXXXX"); then
        echo "install: cannot create temp file in $(dirname "$t")" >&2; status=1; continue
      fi
      if sentinel_compose_adapter "$t" "$blockfile" "$out"; then
        if [[ -f "$t" ]] && cmp -s "$t" "$out"; then
          echo "unchanged: $t"; rm -f "$out"
        else
          mv "$out" "$t"; echo "wrote:     $t"; changed=1
        fi
      else
        rm -f "$out"
        echo "install: $t has AGENT-RULES:BEGIN without AGENT-RULES:END; refusing to write" >&2
        echo "         (it would silently drop your trailing content). Fix the markers." >&2
        status=1
      fi
      ;;
  esac
done < <(targets)

if [[ "$SCOPE" == global ]]; then
  echo
  if [[ -f "${CODEX_HOME:-$HOME/.codex}/AGENTS.override.md" ]]; then
    echo "warning: Codex will load ${CODEX_HOME:-$HOME/.codex}/AGENTS.override.md"
    echo "         before ${CODEX_HOME:-$HOME/.codex}/AGENTS.md; Sentinel is installed"
    echo "         but may be shadowed for Codex until the override is reconciled."
    echo
  fi
  echo "note: GitHub Copilot has no global file entrypoint. Set user-wide rules"
  echo "      manually: VS Code 'Chat: New Instructions File -> New (User)' with"
  echo "      applyTo: '**', and/or github.com Copilot personal instructions."
fi

case "$ACTION" in
  check)
    if [[ "$status" -eq 0 ]]; then echo "sentinel install: blocks up to date."; else echo "sentinel install: out of date (drift or missing); run tools/install." >&2; fi
    ;;
  write)
    if [[ "$changed" -eq 1 ]]; then echo "sentinel install: done ($SCOPE)."; else echo "sentinel install: already up to date ($SCOPE)."; fi
    ;;
  remove)
    if [[ "$changed" -eq 1 ]]; then echo "sentinel install: removed ($SCOPE)."; else echo "sentinel install: nothing to remove ($SCOPE)."; fi
    ;;
esac
exit "$status"
