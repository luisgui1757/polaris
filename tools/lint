#!/usr/bin/env bash
# Polaris lint gate: yamllint + editorconfig-checker + gitleaks + check-jsonschema.
#
# Single source for the lint checks so the LOCAL gate (tools/ci, the pre-push
# hook, release-check) runs exactly what the GitHub `lint` job runs. A lint
# FAILURE always propagates (set -e) -- it is never masked.
#
# Strict vs. lenient (the gold-standard "no silent skip" rule):
#   - POLARIS_STRICT=1 (or --strict): every linter MUST be installed; a missing
#     one FAILS the gate. CI and release-check run strict, so the required gate
#     is real -- it can never report "passed" having scanned nothing.
#   - default (a clean dev clone): a missing linter is SKIPPED loudly and counted,
#     and the final line names what was skipped so "passed" is never mistaken for
#     a full run.
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_ROOT"

STRICT="${POLARIS_STRICT:-0}"
[[ "${1:-}" == "--strict" ]] && STRICT=1

skipped=()

# require_tool <cmd>: 0 if present; in strict mode a missing tool aborts, else it
# is recorded as skipped and the caller moves on.
require_tool() {
  local tool=$1
  if command -v "$tool" >/dev/null 2>&1; then
    return 0
  fi
  if [[ "$STRICT" == 1 ]]; then
    echo "lint: FAIL: '$tool' is required in strict mode but is not installed." >&2
    exit 1
  fi
  echo "lint: $tool not installed; SKIPPING (set POLARIS_STRICT=1 to require it)" >&2
  skipped+=("$tool")
  return 1
}

if require_tool yamllint; then
  echo "lint: yamllint"; yamllint .github/ .yamllint
fi

if require_tool editorconfig-checker; then
  echo "lint: editorconfig-checker"; editorconfig-checker
fi

if require_tool gitleaks; then
  echo "lint: gitleaks"; gitleaks detect --source . --no-banner --redact
fi

if require_tool check-jsonschema; then
  echo "lint: check-jsonschema (MANIFEST.json vs canonical schema)"
  check-jsonschema --schemafile schemas/manifest.schema.json MANIFEST.json
fi

if ((${#skipped[@]})); then
  echo "lint: passed, but NOT a full gate -- skipped: ${skipped[*]} (run in CI / POLARIS_STRICT=1 for the real gate)."
else
  echo "lint: passed (all linters ran)."
fi
