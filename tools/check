#!/usr/bin/env bash
# Polaris check CLI.
#
# Verifies the Polaris core against MANIFEST.json (structure + a lightweight
# manifest validation) and runs a privacy leak scan over the WHOLE working tree
# -- tracked AND not-yet-tracked files, minus only gitignored files -- plus the
# path NAMES themselves and the manifest. A private term or absolute home path
# anywhere is caught; private hits are redacted (location only). Finally it
# enforces the injected-bundle byte budget.
#
# The generic, consumer-reusable half lives in tools/polaris-lib.sh. Consumers
# source that and add their own overlay-aware checks; they do not reimplement
# this CLI.
set -euo pipefail
export LC_ALL=C   # byte-wise, locale-independent matching/sorting -> reproducible

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

# shellcheck source=polaris-lib.sh
source "$SCRIPT_DIR/polaris-lib.sh"

MANIFEST="$REPO_ROOT/MANIFEST.json"
CORE="$REPO_ROOT/core"
status=0

# 1. Core structure + core-directory term scan.
polaris_check_core "$CORE" "$MANIFEST" || status=1

# 2. Lightweight manifest validation (jq only; no-op without jq).
if _polaris_have_jq; then
  if ! jq -e '
        (.schema_version | type == "number")
        and (.name == "polaris")
        and (.required_core_read_order | type == "array")
        and (.forbidden_core_terms | type == "array")
        and ((.render_budget_bytes // 0) | (type == "number" and . == floor))
      ' "$MANIFEST" >/dev/null 2>&1; then
    echo "polaris: MANIFEST.json failed validation (schema_version/name/arrays/budget types)." >&2
    status=1
  fi
fi

# 3. Collect working-tree paths (tracked + untracked, minus ignored), excluding
#    the manifest (declares generic terms; scanned separately in step 5) and the
#    gitignored local denylist. NUL-delimited so odd filenames are not skipped.
rel_paths=()
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  while IFS= read -r -d '' f; do
    case "$f" in MANIFEST.json | tools/forbidden-terms.local) continue ;; esac
    rel_paths+=("$f")
  done < <(git -C "$REPO_ROOT" ls-files -z --cached --others --exclude-standard)
else
  while IFS= read -r -d '' f; do
    rel_paths+=("${f#"$REPO_ROOT"/}")
  done < <(find "$REPO_ROOT" -type f -not -path "*/.git/*" \
    -not -name 'MANIFEST.json' -not -name 'forbidden-terms.local' -print0)
fi

# 4a. Content scan over REGULAR files. Symlinks are NOT followed -- their target
#     may be outside the repo; their names are still checked in 4b.
content_paths=()
for f in ${rel_paths[@]+"${rel_paths[@]}"}; do
  [[ -L "$REPO_ROOT/$f" ]] && continue
  content_paths+=("$REPO_ROOT/$f")
done
if ((${#content_paths[@]})); then
  polaris_scan_terms "$MANIFEST" "${content_paths[@]}" || status=1
fi

# 4b. Path-name scan: a private term in a file/dir NAME itself.
if ((${#rel_paths[@]})); then
  polaris_scan_pathnames "$MANIFEST" "${rel_paths[@]}" || status=1
fi

# 5. Scan the manifest for leaks. It legitimately DECLARES the generic terms in
#    its forbidden_core_terms array, so do two passes:
#      (a) FULL term set over a projection with that array removed -- catches a
#          generic pattern (e.g. an absolute home path) in any free-text field
#          without self-matching the declarations; and
#      (b) PRIVATE terms over the whole manifest -- catches a private term placed
#          anywhere, including one wrongly dropped inside that array.
if [[ -f "$MANIFEST" ]]; then
  proj=$(mktemp)
  if _polaris_have_jq; then
    # Structural removal of the term-declaration array (robust to ']'-in-string
    # and single-line manifests). On a malformed manifest jq fails -> empty
    # projection (nothing to scan); the validation + render guards catch that.
    jq 'del(.forbidden_core_terms)' "$MANIFEST" > "$proj" 2>/dev/null || : > "$proj"
  else
    awk '
      /"forbidden_core_terms"[[:space:]]*:/ {
        if ($0 ~ /\]/) { next }   # single-line array: drop just this line
        skip = 1; next            # multi-line array: skip until the closing ]
      }
      skip && /\]/ { skip = 0; next }
      skip { next }
      { print }
    ' "$MANIFEST" > "$proj"
  fi
  polaris_scan_terms "$MANIFEST" "$proj" || status=1
  polaris_scan_terms "$MANIFEST" --private "$MANIFEST" || status=1
  rm -f "$proj"
fi

# 6. Injected-bundle budget: FAIL over budget, warn at >=75%.
budget=$(polaris_manifest_int "$MANIFEST" render_budget_bytes || true)
if [[ -n "${budget:-}" ]] && [[ "$budget" =~ ^[0-9]+$ ]] && (( budget > 0 )); then
  size=$(polaris_render_bundle "$CORE" "$MANIFEST" | wc -c | tr -d ' ')
  if (( size > budget )); then
    echo "polaris: ERROR: injected bundle is ${size}B > render_budget_bytes ${budget}B. Trim core/." >&2
    status=1
  elif (( size * 100 / budget >= 75 )); then
    echo "polaris: WARNING: injected bundle is ${size}B, >=75% of the ${budget}B budget." >&2
  fi
fi

if [[ "$status" -eq 0 ]]; then
  echo "polaris: core check passed."
else
  echo "polaris: core check FAILED." >&2
  exit 1
fi
