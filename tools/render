#!/usr/bin/env bash
# Sentinel generic render CLI.
#
# Prints the Sentinel core read-order files (MANIFEST.json then the required
# core files) so a tool or human can paste the contract. Consuming
# repositories render this generic core first, then append their overlay.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

# shellcheck source=sentinel-lib.sh
source "$SCRIPT_DIR/sentinel-lib.sh"

printf '# Sentinel Core\n'
MANIFEST="$REPO_ROOT/MANIFEST.json"
CORE="$REPO_ROOT/$(sentinel_manifest_core_dir "$MANIFEST")"
sentinel_render_core "$CORE" "$MANIFEST"
