#!/usr/bin/env bash
# ShellCheck gate for the shell tooling. Single source so the Makefile, the local
# `tools/ci` gate, and the GitHub `lint` job all run the SAME command. Uses
# --source-path=SCRIPTDIR so `source "$SCRIPT_DIR/sentinel-lib.sh"` resolves and
# the sourced library is followed (no spurious SC1091). Blocking, not advisory:
# a shell-correctness finding fails the gate.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_ROOT"

exec shellcheck -x --source-path=SCRIPTDIR \
  tools/sentinel-lib.sh tools/check tools/install tools/ci tools/lint tools/lint-shell \
  tools/render tools/status tools/install-hooks tools/verify-vendor tools/release-check \
  tools/ruleset-check tools/repository-policy-check \
  scripts/apply-repo-safeguards.sh tests/run.sh
