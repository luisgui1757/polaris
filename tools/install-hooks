#!/usr/bin/env bash
# Install Sentinel's local CI as a git pre-push hook (run once per clone).
#
# The hook runs `make gate` before every push: strict local preflight, ruleset
# semantics, bats, and the PowerShell drift check. Bypass once with
# `git push --no-verify`.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

if [[ ! -d "$REPO_ROOT/.git" ]]; then
  echo "install-hooks: not a git repository: $REPO_ROOT" >&2
  exit 1
fi

HOOK_DIR="$REPO_ROOT/.git/hooks"
mkdir -p "$HOOK_DIR"
cat > "$HOOK_DIR/pre-push" <<'HOOK'
#!/usr/bin/env bash
# Sentinel pre-push gate (installed by tools/install-hooks).
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)
exec make -C "$ROOT" gate
HOOK
chmod +x "$HOOK_DIR/pre-push"
echo "install-hooks: installed $HOOK_DIR/pre-push -> make gate"
