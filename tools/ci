#!/usr/bin/env bash
# Polaris local CI gate -- the same checks GitHub runs, runnable on your machine.
#
# Runs the privacy leak scan, a render smoke test, and the adapter drift check.
# `make install-hooks` wires this into a git pre-push hook so it runs before every
# push, mirroring the GitHub `ci` status check. See README.md.
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

echo "polaris ci: core + whole-tree leak check"
bash "$SCRIPT_DIR/check"

echo "polaris ci: render smoke"
bash "$SCRIPT_DIR/render" > /dev/null

echo "polaris ci: adapter drift check"
bash "$SCRIPT_DIR/install" --check

echo "polaris ci: lint (yaml + editorconfig + secrets + schema)"
bash "$SCRIPT_DIR/lint"

echo "polaris ci: shellcheck (shell tooling correctness)"
if command -v shellcheck >/dev/null 2>&1; then
  bash "$SCRIPT_DIR/lint-shell"
elif [[ "${POLARIS_STRICT:-0}" == 1 ]]; then
  echo "polaris ci: FAIL: shellcheck is required in strict mode but is not installed." >&2
  exit 1
else
  echo "polaris ci: shellcheck not installed; SKIPPING (set POLARIS_STRICT=1 to require it)" >&2
fi

echo "polaris ci: passed."
